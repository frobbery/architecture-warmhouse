@startuml
title Warmhouse Web Application Component Diagram

top to bottom direction

!include ../templates/C4_Component.puml

Container_Boundary(WarmhouseSystem, "Warmhouse System") {
  Container(CameraService, "Camera Service", "Java, Spring", "Handles request for video from camera device")
}

System_Ext(cameraApi, "Camera API", "External API for camera devices")

Container(CameraService, "Camera Service", "Java, Spring") {
  Component(VideoController, "VideoController", "Component: Spring MVC Rest Controller", "Handles requests for videos on certain cameras")
  Component(VideoService, "VideoService", "Component: Spring Bean", "Requests video from certain camera")
  Component(CameraFacade, "CameraFacade", "Component: Spring Bean", "A facade onto camera API")
}

Rel(VideoController,VideoService,"Uses")
Rel(VideoService, CameraFacade, "Uses")
Rel(CameraFacade, cameraApi,"Calls REST API", "JSON/HTTPS")

@enduml
